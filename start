#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="$ROOT/.venv/bin/python"
BACKEND_PID=""
FRONTEND_PID=""
export PHONE_DEMO="${PHONE_DEMO:-1}"
export PHONE_FEED_HOST="${PHONE_FEED_HOST:-0.0.0.0}"
export SIMULATION_DRONE_COUNT="${SIMULATION_DRONE_COUNT:-1}"

cleanup() {
  trap - EXIT INT TERM
  [ -z "$FRONTEND_PID" ] || kill "$FRONTEND_PID" 2>/dev/null || true
  [ -z "$BACKEND_PID" ] || kill "$BACKEND_PID" 2>/dev/null || true
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if [ ! -x "$PYTHON" ]; then
  echo "Setting up Python…"
  python3 -m venv "$ROOT/.venv"
fi
if ! "$PYTHON" -c "import fastapi, uvicorn, simulation" >/dev/null 2>&1; then
  echo "Installing Python dependencies…"
  "$PYTHON" -m pip install -e "$ROOT[test]"
fi
if [ ! -d "$ROOT/3d-mapping/node_modules" ] || ! npm --prefix "$ROOT/3d-mapping" ls --depth=0 >/dev/null 2>&1; then
  echo "Setting up the 3D frontend…"
  npm --prefix "$ROOT/3d-mapping" install
fi

if curl -fsS http://127.0.0.1:8000/api/state >/dev/null 2>&1; then
  if ! curl -fsS http://127.0.0.1:8000/api/phones | "$PYTHON" -c 'import json,sys; d=json.load(sys.stdin); assert d["phone_demo"] and d["listening"] and d["host"] != "127.0.0.1"'; then
    echo "An older or incompatible server is running on port 8000. Stop its ./start process and run this command again." >&2
    exit 1
  fi
  echo "Using the runtime already running on port 8000."
else
  echo "Starting mission runtime…"
  "$PYTHON" -m uvicorn server.main:app --app-dir "$ROOT" --reload --reload-dir "$ROOT" &
  BACKEND_PID=$!
fi

echo "Building optimized 3D mission control…"
npm --prefix "$ROOT/3d-mapping" run build
if curl -fsS http://127.0.0.1:5173/ >/dev/null 2>&1; then
  echo "Using the 3D frontend already running on port 5173."
else
  echo "Starting 3D mission control…"
  "$PYTHON" -m http.server 5173 --bind 127.0.0.1 --directory "$ROOT/3d-mapping/dist" &
  FRONTEND_PID=$!
fi

for _ in {1..80}; do
  if curl -fsS http://127.0.0.1:8000/api/state >/dev/null 2>&1 \
    && curl -fsS http://127.0.0.1:5173/ >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done
if ! curl -fsS http://127.0.0.1:8000/api/state >/dev/null 2>&1 \
  || ! curl -fsS http://127.0.0.1:5173/ >/dev/null 2>&1; then
  echo "Demo startup failed. Check the logs above for a port or dependency error." >&2
  exit 1
fi
if ! curl -fsS http://127.0.0.1:8000/api/phones | "$PYTHON" -c 'import json,sys; d=json.load(sys.stdin); assert d["listening"] and d["phone_demo"]'; then
  echo "Phone receiver did not start. Check whether UDP port 9870 is already in use." >&2
  exit 1
fi

URL="http://127.0.0.1:5173/?mode=local"
echo "Ready: $URL"
echo "Phone demo: one drone; gestures are processed on the iPhones."
echo "Join one room: 5 phones, 3-phone flat test, or 2-phone gesture test."
LAN_IP="$(ipconfig getifaddr en0 2>/dev/null || true)"
echo "Set each phone's Visualizer host to ${LAN_IP:-MAC_WIFI_IP}:${PHONE_FEED_PORT:-9870}."
echo "Phones and this computer need the same trusted Wi-Fi network."
if [ "${1:-}" != "--no-open" ]; then
  if command -v open >/dev/null 2>&1; then open "$URL"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL"
  fi
fi
echo "Press Ctrl+C to stop."

if [ -n "$BACKEND_PID$FRONTEND_PID" ]; then
  wait
else
  while true; do sleep 3600; done
fi
