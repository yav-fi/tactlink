#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="$ROOT/.venv/bin/python"
BACKEND_PID=""
FRONTEND_PID=""
CHAT_PID=""
GESTURE_PID=""

cleanup() {
  trap - EXIT INT TERM
  [ -z "$FRONTEND_PID" ] || kill "$FRONTEND_PID" 2>/dev/null || true
  [ -z "$BACKEND_PID" ] || kill "$BACKEND_PID" 2>/dev/null || true
  [ -z "$CHAT_PID" ] || kill "$CHAT_PID" 2>/dev/null || true
  [ -z "$GESTURE_PID" ] || kill "$GESTURE_PID" 2>/dev/null || true
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if [ ! -x "$PYTHON" ]; then
  echo "Setting up Python…"
  python3 -m venv "$ROOT/.venv"
fi
if ! "$PYTHON" -c "import fastapi, uvicorn, simulation, cv2, mediapipe" >/dev/null 2>&1; then
  echo "Installing Python dependencies…"
  "$PYTHON" -m pip install -e "$ROOT[gesture,test]"
fi
if [ ! -d "$ROOT/3d-mapping/node_modules" ]; then
  echo "Setting up the 3D frontend…"
  npm --prefix "$ROOT/3d-mapping" install
fi

if [ -e "$ROOT/models/qwen3.5-9b-4bit" ] && [ -e "$ROOT/models/dflash-qwen3.5-9b-w4gs64" ] \
  && ! "$PYTHON" -c "import chad, transformers" >/dev/null 2>&1; then
  echo "Installing mission AI dependencies…"
  "$PYTHON" -m pip install chad-code transformers
fi

if curl -fsS http://127.0.0.1:8081/health >/dev/null 2>&1; then
  echo "Using the mission AI already running on port 8081."
elif [ -e "$ROOT/models/qwen3.5-9b-4bit" ] && [ -e "$ROOT/models/dflash-qwen3.5-9b-w4gs64" ]; then
  echo "Starting mission AI in the background…"
  env PATH="$ROOT/.venv/bin:$PATH" "$ROOT/scripts/start_chat_server.sh" --model qwen3.5-9b &
  CHAT_PID=$!
else
  echo "Mission AI model is not installed; built-in text commands remain available."
fi

if curl -fsS http://127.0.0.1:8000/api/state >/dev/null 2>&1; then
  echo "Using the runtime already running on port 8000."
else
  echo "Starting mission runtime…"
  "$PYTHON" -m uvicorn server.main:app --app-dir "$ROOT" --reload --reload-dir "$ROOT" &
  BACKEND_PID=$!
fi

echo "Starting webcam gesture control in the background…"
env MPLCONFIGDIR="${TMPDIR:-/tmp}/dnhacks-matplotlib" "$PYTHON" "$ROOT/src/gesture_bridge.py" &
GESTURE_PID=$!

if curl -fsS http://127.0.0.1:5173/ >/dev/null 2>&1; then
  echo "Using the 3D frontend already running on port 5173."
else
  echo "Building and starting optimized 3D mission control…"
  npm --prefix "$ROOT/3d-mapping" run build
  "$PYTHON" -m http.server 5173 --bind 127.0.0.1 --directory "$ROOT/3d-mapping/dist" &
  FRONTEND_PID=$!
fi

for _ in {1..80}; do
  if curl -fsS http://127.0.0.1:8000/api/state >/dev/null 2>&1 && curl -fsS http://127.0.0.1:5173/ >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done
if ! curl -fsS http://127.0.0.1:8000/api/state >/dev/null 2>&1 || ! curl -fsS http://127.0.0.1:5173/ >/dev/null 2>&1; then
  echo "Demo startup failed. Check the logs above for a port or dependency error." >&2
  exit 1
fi

URL="http://127.0.0.1:5173/?mode=local"
echo "Ready: $URL"
if [ "${1:-}" != "--no-open" ]; then
  if command -v open >/dev/null 2>&1; then open "$URL"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL"
  fi
fi
echo "Press Ctrl+C to stop."

if [ -n "$BACKEND_PID$FRONTEND_PID$CHAT_PID$GESTURE_PID" ]; then
  wait
else
  while true; do sleep 3600; done
fi
